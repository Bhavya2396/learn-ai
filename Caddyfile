# ZOE — Caddy reverse proxy for zoe.calance.ai
#
# Caddy enables automatic HTTPS by default: it obtains and renews a Let's
# Encrypt certificate for this domain and redirects HTTP → HTTPS for you.
# Requirements: the domain's A record points at this host, and ports 80 + 443
# are open to the internet (80 is needed for the ACME challenge).

zoe.calance.ai {
	reverse_proxy localhost:3000
}

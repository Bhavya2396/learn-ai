# ---------------------------------------------------------------------------
# AI provider keys
#
# ZOE uses two LLM providers. At least one must be set for text generation
# (OpenRouter is preferred, Google Gemini is the fallback). Some multimodal
# features (image/audio) require GOOGLE_API_KEY specifically.
# ---------------------------------------------------------------------------

# Google Gemini API key — used for multimodal (image/audio) analysis and as a
# text-generation fallback. Get one at https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# OpenRouter API key — preferred provider for text generation.
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Mistral API key — used for document OCR (src/lib/zoe/mistral-ocr.ts). Reads
# uploaded PDFs/images (scanned included) into markdown AND describes every
# figure via bbox annotations. Required for document upload / document-sourced
# journeys. Get one at https://console.mistral.ai/api-keys
MISTRAL_API_KEY=

# ---------------------------------------------------------------------------
# Firebase Authentication (Google sign-in)
#
# Auth is handled by Firebase. The client SDK signs the user in with Google and
# gets an ID token; the server verifies that token with firebase-admin and maps
# the Firebase uid → users.id in Postgres (all app data is keyed by that uid).
#
# CLIENT config (safe to expose — these are public identifiers, not secrets).
# From Firebase console → Project settings → General → "Your apps" (Web app).
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyAB6eMBAfcBsIVvog6A3zgMlDRI1e-LkNo
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=zoe-calance-ai.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=zoe-calance-ai
NEXT_PUBLIC_FIREBASE_APP_ID=1:648691246209:web:2605bfc76837fe9f5d9980
# Optional (only needed for some Firebase features; safe to leave blank):
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# SERVER credentials — a service account for firebase-admin to verify ID tokens.
# From Firebase console → Project settings → Service accounts → "Generate new
# private key". Provide it ONE of two ways (the code accepts either):
#   (a) the whole JSON, single-lined, in FIREBASE_SERVICE_ACCOUNT, or
#   (b) the three fields below (keep \n escapes in the private key).
# Keep these SECRET — never expose them to the client.
# FIREBASE_SERVICE_ACCOUNT={"project_id":"...","client_email":"...","private_key":"..."}
FIREBASE_PROJECT_ID=zoe-calance-ai
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-fbsvc@zoe-calance-ai.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQDBPBtuuoFNZvgE\nySrT0F3OMKyWo1KrMkjJdz2+tNCcCJOk00d/gw3++aPqMkgWoRK+AVkF2dvf5Ucm\nsfZjGB+JUIkROsr4ed7DOf5y69zZKRBROaNsHdeK3brqJJNbaFuq650USjPEfDY/\nrL/Kw1K5v7L0NXh2t8rwXjVGNwCkwIvZOnQf8wPAmWXvvVwe5q2kFzgM+AEGp8+/\naDHP3t2OKCJBbYiXjwXo4zQcPzDAggyGQBU+Tp5XwKNNPbDqmCQMEIk9kD2P8a/G\nS6qxvFUPIik/9gt2IBhxMbZ0jNXFh5/ReNHKvt/2fxjxwyizeBSYpV0CHbN8ZSbz\nNp/b3vG3AgMBAAECggEASEOvSqirBIRWiouk3ZPWEO85DBjGKMnkWJukVraOMVwv\nwvtUiMY9LLa1azckqHnSZYZhgYOo68F1622wY/y4hoS8zdm74FLLUR1WICo+7GOj\n+4xfpmY+nmsvpLLK/Os5JOF6XAUn+Pou239CNpT3Ugnz5co9Y8B2P5Arwjd9oR7O\nknff5brqrAKuYHHkzYruRaZyWi3VraASAJ4yHZzX0KifHcJ7kBBXngx/k0tMIpJ9\n1FtzszG1nQDCqW09tYMucUhxwiOGz1u9TDVc30TQbiF3ubru2OTz9VQNXhR66vYh\n/qFJLfw8yClkJukjKseUlDSFZDW2svchgb7weqARoQKBgQDfdKyAOA/0PJbBvgxH\nF3NbVj2TbNjW6DLOW71QVXj3Ooj+FMWJt6KWtI3VTAr66uMl7GjVPferBIV3hlv9\nz9cnbSaig6oe5/TKd4RpJZn66e+6Q7c3NzUCywiXF5qISPrOYxR6hyVE3u/ERE8C\njtsJWpPKKkc2V2OpbGl9R+b2sQKBgQDdYKy4Z2nki4xLO0RggEsJWWJxbWNCBenh\nSMI9KDn+iy9sIzJ2p2U8XSQ1gULJh7bblTibzAQB84oOZIqoqXTfnsTEs0NlOYuv\nNn83DcsDU2r20oVJNlhM7qkGxhluIihDXosy5CiMzzGyfh+tphK8bPde9wP3y3Yd\nqY7ehaHY5wKBgQDcWz5RIvf4rlcsr7GD2chUZfNLEqezJkAT57wFIIStqPe3N9yl\nNoYLf/nuQZMCZeeiWkP3Jai66TaE6+aDoRZXNvhGgvicibmIf9v/pKj4GwHg+S4Q\nMU0BeB78gLZPd0h9ho+HVQaXqBFhxsrzhtTRoJTlZFPdbshFJzfP57wHwQKBgE1L\nDcMsyDo1xvwVa2BOKuTOwqJb0QYiTnCMGNWFkAohyqL0/w+SjrQuyQ+tXAZFTkEI\nrsUmzFdqEs/HpuoQkG/rXURYWrWjC/RXEL/GHxXAMF6RTlwrj1T9FyL4U7SyVGCB\nSBSyuL3BMdbiVmkozO3hFdWgZVBFR64/n1RuT/4NAoGBAK5bxMXkKQ6ZScY8X51r\nVuls0wY8RMYcPPH1LWTbvAwOLd1cnoVB5P1Tcy1QNP93PSzhOugWO+ETBlvOdSqz\nVYJavacnLZ14OL09rMcHep/4wTsh2SmLl0ETGWfjzEyhwyJr3KGKP4xywLWTUXM7\nlPNtyS/25dk07R8Vldn+WjC2\n-----END PRIVATE KEY-----\n

# ---------------------------------------------------------------------------
# Database (PostgreSQL + pgvector)
#
# Server-side persistence for the ZOE "brain" (identity, profile, aspirations,
# memory, ZOT ledger). See src/lib/db/. After the db is up, provision it with:
#   npm run db:migrate
# ---------------------------------------------------------------------------

# Postgres connection string used by the app (src/lib/db/client.ts) and by
# migrations (drizzle.config.ts). Any pgvector-capable Postgres works
# (local, Neon, Supabase, RDS). For the docker-compose db, this matches the
# POSTGRES_* values below:
#   postgresql://user:password@localhost:5432/zoe
DATABASE_URL=postgresql://zoe:zoe@localhost:5432/zoe

# TLS for hosted Postgres. Leave unset for local; "require" for most cloud
# providers (Neon/Supabase), "disable" to force plaintext.
# PGSSL=require

# Max connections in the pool (optional; defaults to 10).
# PGPOOL_MAX=10

# ---------------------------------------------------------------------------
# docker-compose Postgres — used ONLY by docker-compose.yml to provision the
# `db` container. These must agree with DATABASE_URL above. Safe defaults are
# baked into the compose file, so setting them here is optional (override for a
# non-default password/db name).
# ---------------------------------------------------------------------------

# POSTGRES_USER=zoe
# POSTGRES_PASSWORD=zoe
# POSTGRES_DB=zoe

# Host ports the compose services publish (optional).
# DB_PORT=5432
# APP_PORT=3000



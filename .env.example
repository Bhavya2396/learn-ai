# ---------------------------------------------------------------------------
# AI provider keys
#
# ZOE uses two LLM providers. At least one must be set for text generation
# (OpenRouter is preferred, Google Gemini is the fallback). Some multimodal
# features (image/audio) require GOOGLE_API_KEY specifically.
# ---------------------------------------------------------------------------

# Google Gemini API key — used for multimodal (image/audio) analysis and as a
# text-generation fallback. Get one at https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# OpenRouter API key — preferred provider for text generation.
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Mistral API key — used for document OCR (src/lib/zoe/mistral-ocr.ts). Reads
# uploaded PDFs/images (scanned included) into markdown AND describes every
# figure via bbox annotations. Required for document upload / document-sourced
# journeys. Get one at https://console.mistral.ai/api-keys
MISTRAL_API_KEY=

# ---------------------------------------------------------------------------
# Database (PostgreSQL + pgvector)
#
# Server-side persistence for the ZOE "brain" (identity, profile, aspirations,
# memory, ZOT ledger). See src/lib/db/. After the db is up, provision it with:
#   npm run db:migrate
# ---------------------------------------------------------------------------

# Postgres connection string used by the app (src/lib/db/client.ts) and by
# migrations (drizzle.config.ts). Any pgvector-capable Postgres works
# (local, Neon, Supabase, RDS). For the docker-compose db, this matches the
# POSTGRES_* values below:
#   postgresql://user:password@localhost:5432/zoe
DATABASE_URL=postgresql://zoe:zoe@localhost:5432/zoe

# TLS for hosted Postgres. Leave unset for local; "require" for most cloud
# providers (Neon/Supabase), "disable" to force plaintext.
# PGSSL=require

# Max connections in the pool (optional; defaults to 10).
# PGPOOL_MAX=10

# ---------------------------------------------------------------------------
# docker-compose Postgres — used ONLY by docker-compose.yml to provision the
# `db` container. These must agree with DATABASE_URL above. Safe defaults are
# baked into the compose file, so setting them here is optional (override for a
# non-default password/db name).
# ---------------------------------------------------------------------------

# POSTGRES_USER=zoe
# POSTGRES_PASSWORD=zoe
# POSTGRES_DB=zoe

# Host ports the compose services publish (optional).
# DB_PORT=5432
# APP_PORT=3000



# Dependencies & build output (reinstalled/rebuilt inside the image)
node_modules
.next
out
build

# Env & secrets — never bake into the image
.env
.env.*
!.env.example

# Version control & tooling
.git
.gitignore
.github
.vscode
.cursor
.idea

# Local certs (only used by dev:https)
certificates

# Docs, papers, large binaries not needed at runtime
*.md
!src/lib/db/README.md
*.pdf
public/FinalContent/**/*.pdf

# Misc
npm-debug.log*
Dockerfile
.dockerignore
docker-compose.yml
